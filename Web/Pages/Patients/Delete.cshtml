@page "{id:int}"
@model Web.Pages.Patients.DeleteModel
@{
    ViewData["Title"] = "Usuń pacjenta";
}

<h1>Usuń pacjenta</h1>

<div class="alert alert-warning">
    Czy na pewno chcesz usunąć tego pacjenta? Operacja jest odwracalna tylko przez administratora.
</div>

<dl class="row mb-4">
    <dt class="col-sm-3">PESEL</dt>
    <dd class="col-sm-9">@Model.Patient.Pesel</dd>

    <dt class="col-sm-3">Imię i nazwisko</dt>
    <dd class="col-sm-9">@Model.Patient.FirstName @Model.Patient.LastName</dd>

    <dt class="col-sm-3">Data urodzenia</dt>
    <dd class="col-sm-9">@Model.Patient.BirthDate.ToString("dd.MM.yyyy")</dd>
</dl>

<form method="post">
    <button type="submit" class="btn btn-danger">Tak, usuń</button>
    <a asp-page="./Details" asp-route-id="@Model.Patient.Id" class="btn btn-outline-secondary ms-2">Anuluj</a>
</form>
