@page "{id:int}"
@model Web.Pages.Patients.EditModel
@{
    ViewData["Title"] = "Edytuj pacjenta";
}

<h1>Edytuj pacjenta</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">PESEL</label>
                <input value="@Model.Pesel" class="form-control" disabled />
                <small class="text-muted">PESEL nie może być zmieniany.</small>
            </div>
            <div class="mb-3">
                <label asp-for="Input.FirstName" class="form-label">Imię</label>
                <input asp-for="Input.FirstName" class="form-control" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.LastName" class="form-label">Nazwisko</label>
                <input asp-for="Input.LastName" class="form-control" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.BirthDate" class="form-label">Data urodzenia</label>
                <input asp-for="Input.BirthDate" type="date" class="form-control" />
                <span asp-validation-for="Input.BirthDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.InsuranceNumber" class="form-label">Nr ubezpieczenia</label>
                <input asp-for="Input.InsuranceNumber" class="form-control" />
                <span asp-validation-for="Input.InsuranceNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.PhoneNumber" class="form-label">Telefon</label>
                <input asp-for="Input.PhoneNumber" class="form-control" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">E-mail</label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Address" class="form-label">Adres</label>
                <input asp-for="Input.Address" class="form-control" />
                <span asp-validation-for="Input.Address" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
            <a asp-page="./Details" asp-route-id="@Model.PatientId" class="btn btn-outline-secondary ms-2">Anuluj</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
