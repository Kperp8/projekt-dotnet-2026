@page "{id:int}"
@model Web.Pages.Patients.DetailsModel
@{
    ViewData["Title"] = "Szczegóły pacjenta";
}

<h1>Szczegóły pacjenta</h1>

<dl class="row mb-4">
    <dt class="col-sm-3">PESEL</dt>
    <dd class="col-sm-9">@Model.Patient.Pesel</dd>

    <dt class="col-sm-3">Imię</dt>
    <dd class="col-sm-9">@Model.Patient.FirstName</dd>

    <dt class="col-sm-3">Nazwisko</dt>
    <dd class="col-sm-9">@Model.Patient.LastName</dd>

    <dt class="col-sm-3">Data urodzenia</dt>
    <dd class="col-sm-9">@Model.Patient.BirthDate.ToString("dd.MM.yyyy")</dd>

    <dt class="col-sm-3">Nr ubezpieczenia</dt>
    <dd class="col-sm-9">@Model.Patient.InsuranceNumber</dd>

    <dt class="col-sm-3">Telefon</dt>
    <dd class="col-sm-9">@Model.Patient.PhoneNumber</dd>

    <dt class="col-sm-3">E-mail</dt>
    <dd class="col-sm-9">@Model.Patient.Email</dd>

    <dt class="col-sm-3">Adres</dt>
    <dd class="col-sm-9">@Model.Patient.Address</dd>

    <dt class="col-sm-3">Liczba wizyt</dt>
    <dd class="col-sm-9">@Model.Patient.VisitsCount</dd>
</dl>

<a asp-page="./Edit" asp-route-id="@Model.Patient.Id" class="btn btn-primary">Edytuj</a>
<a asp-page="./Delete" asp-route-id="@Model.Patient.Id" class="btn btn-outline-danger ms-2">Usuń</a>
<a asp-page="./Index" class="btn btn-outline-secondary ms-2">Wróć do listy</a>
