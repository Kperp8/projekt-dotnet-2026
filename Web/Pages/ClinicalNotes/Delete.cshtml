@page "{id:int}"
@model Web.Pages.ClinicalNotes.DeleteModel
@{
    ViewData["Title"] = "Usuń notatkę kliniczną";
}

<h1>Usuń notatkę kliniczną</h1>

<div class="alert alert-danger">
    Czy na pewno chcesz trwale usunąć tę notatkę? Operacja jest nieodwracalna.
</div>

<dl class="row mb-4">
    <dt class="col-sm-3">Nr notatki</dt>
    <dd class="col-sm-9">@Model.Note.Id</dd>

    <dt class="col-sm-3">Diagnoza</dt>
    <dd class="col-sm-9">@Model.Note.Diagnosis</dd>

    <dt class="col-sm-3">Zalecenia</dt>
    <dd class="col-sm-9">@Model.Note.Recommendations</dd>
</dl>

<form method="post">
    <button type="submit" class="btn btn-danger">Tak, usuń</button>
    <a asp-page="./Details" asp-route-id="@Model.Note.Id" class="btn btn-outline-secondary ms-2">Anuluj</a>
</form>
