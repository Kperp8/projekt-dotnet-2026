@page "{id:int}"
@model Web.Pages.Medications.EditModel
@{
    ViewData["Title"] = "Edytuj lek";
}

<h1>Edytuj lek</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Nazwa</label>
                <input value="@Model.MedicationName" class="form-control" disabled />
                <small class="text-muted">Nazwa leku nie może być zmieniana.</small>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Dosing" class="form-label">Dozowanie</label>
                <input asp-for="Input.Dosing" class="form-control" />
                <span asp-validation-for="Input.Dosing" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Cost" class="form-label">Cena (PLN)</label>
                <input asp-for="Input.Cost" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Input.Cost" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
            <a asp-page="./Details" asp-route-id="@Model.MedicationId" class="btn btn-outline-secondary ms-2">Anuluj</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
