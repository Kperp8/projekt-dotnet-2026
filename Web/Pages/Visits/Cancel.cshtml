@page "{id:int}"
@model Web.Pages.Visits.CancelModel
@{
    ViewData["Title"] = "Anuluj wizytę";
}

<h1>Anuluj wizytę</h1>

<div class="alert alert-warning">
    Czy na pewno chcesz anulować tę wizytę? Wizyta zostanie oznaczona jako anulowana i nie będzie można jej ponownie aktywować.
</div>

<dl class="row mb-4">
    <dt class="col-sm-3">Pacjent</dt>
    <dd class="col-sm-9">@Model.Visit.PatientFullName</dd>

    <dt class="col-sm-3">Data wizyty</dt>
    <dd class="col-sm-9">@Model.Visit.ScheduledAt.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Visit.Status</dd>

    <dt class="col-sm-3">Lekarz</dt>
    <dd class="col-sm-9">@(Model.Visit.AssignedDoctorId ?? "—")</dd>
</dl>

<form method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <button type="submit" class="btn btn-danger">Tak, anuluj wizytę</button>
    <a asp-page="./Details" asp-route-id="@Model.Visit.Id" class="btn btn-outline-secondary ms-2">Wróć</a>
</form>
