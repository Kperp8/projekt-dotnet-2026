@page "{id:int}"
@model Web.Pages.Visits.DetailsModel
@{
    ViewData["Title"] = "Szczegóły wizyty";
}

<h1>Szczegóły wizyty</h1>

<dl class="row mb-4">
    <dt class="col-sm-3">Pacjent</dt>
    <dd class="col-sm-9">@Model.Visit.PatientFullName</dd>

    <dt class="col-sm-3">Data wizyty</dt>
    <dd class="col-sm-9">@Model.Visit.ScheduledAt.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        <span class="badge @DetailsModel.StatusBadgeClass(Model.Visit.Status)">
            @DetailsModel.StatusLabel(Model.Visit.Status)
        </span>
    </dd>

    <dt class="col-sm-3">Lekarz</dt>
    <dd class="col-sm-9">@(Model.Visit.AssignedDoctorId ?? "—")</dd>
</dl>

<a asp-page="./Edit" asp-route-id="@Model.Visit.Id" class="btn btn-primary">Edytuj</a>
@if (Model.Visit.Status != VisitStatus.Cancelled && Model.Visit.Status != VisitStatus.Completed)
{
    <a asp-page="./Cancel" asp-route-id="@Model.Visit.Id" class="btn btn-outline-danger ms-2">Anuluj wizytę</a>
}
<a asp-page="./Index" class="btn btn-outline-secondary ms-2">Wróć do listy</a>
