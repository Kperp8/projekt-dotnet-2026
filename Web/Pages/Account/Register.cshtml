@page
@model Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Rejestracja";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-4">Rejestracja</h2>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.FirstName" class="form-label">Imię</label>
                <input asp-for="Input.FirstName" class="form-control" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.LastName" class="form-label">Nazwisko</label>
                <input asp-for="Input.LastName" class="form-control" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Hasło</label>
                <input asp-for="Input.Password" class="form-control" type="password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.ComparePassword" class="form-label">Powtórz hasło</label>
                <input asp-for="Input.ComparePassword" class="form-control" type="password" />
                <span asp-validation-for="Input.ComparePassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Role" class="form-label">Rola</label>
                <select asp-for="Input.Role" class="form-select">
                    <option value="Rejestratorka">Rejestratorka</option>
                    <option value="Lekarz">Lekarz</option>
                    <option value="Admin">Admin</option>
                </select>
                <span asp-validation-for="Input.Role" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Zarejestruj</button>
        </form>
        <div class="mt-3">
            <a asp-page="/Account/Login">Masz już konto? Zaloguj się</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
